---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FeatureBlock from '../components/FeatureBlock.astro';
import Shot from '../components/Shot.astro';
import { themes, themeRegistryUrl } from '../data/themes';
import { systems } from '../data/systems';
import { mediaKinds } from '../data/mediaKinds';

const faqs = [
  {
    q: 'Does it come with anything to watch or play?',
    a: 'No. EverythingBox is a player and a library. It ships no media, no games and no BIOS files — it plays what you already have and what you choose to connect it to.',
  },
  {
    q: 'Does it work on a television?',
    a: 'Yes. Every screen is navigable with a D-pad, and the Android build carries a TV launcher entry, so it works on Android TV devices, Shield and Google TV with a remote or a controller.',
  },
  {
    q: 'What does it cost?',
    a: 'Nothing. It is free software under the GPLv3 — you can use it, study it, change it and share it.',
  },
  {
    q: 'Do I need to convert or rename my files?',
    a: 'No. Video runs on libmpv, which plays essentially anything, and the library scans your folders in place without renaming or moving anything.',
  },
];
---

<Base
  title="EverythingBox — one app for everything you watch, play and read"
  description="A native media hub for films, shows, games, music, audiobooks, books, comics and manga. Windows, macOS, Linux, Android TV and iOS. Free and open source."
  wide
>
  <Hero />

  <div class="mx-auto w-full max-w-6xl px-5">
    <section class="grid gap-6 border-t border-edge/60 py-12 text-center sm:grid-cols-3">
      <div>
        <p class="display text-4xl text-accent">{mediaKinds.length}</p>
        <p class="mt-1 text-sm text-muted">kinds of media, one library</p>
      </div>
      <div>
        <p class="display text-4xl text-accent">{systems.length}</p>
        <p class="mt-1 text-sm text-muted">game systems</p>
      </div>
      <div>
        <p class="display text-4xl text-accent">5</p>
        <p class="mt-1 text-sm text-muted">platforms, one codebase</p>
      </div>
    </section>

    <FeatureBlock
      eyebrow="Video"
      title="Plays what other apps refuse to"
      body="Video runs on libmpv, the engine behind mpv. MKV, HEVC, AV1, AC3 — including large files streamed rather than copied first. Subtitles, per-file resume, and a chapter-aware skip for intros and recaps."
      shotId="video-library"
    />
    <FeatureBlock
      eyebrow="Games"
      title="Sixty-three systems, nothing to configure"
      body="Cores load straight into the application, so retro systems just run. For modern consoles the app fetches the established standalone emulator from its official source and sets it up for you. Four controllers, per-port remapping, rumble, save states and achievements."
      shotId="games-library"
      flip
    />
    <FeatureBlock
      eyebrow="Music & audiobooks"
      title="A folder is a playlist"
      body="MP3, FLAC, OGG and the rest, with folder queueing, automatic advance, and cover art matched in for you. Audiobooks and podcasts sit in the same library and pick up where you stopped."
      shotId="music-library"
    />
    <FeatureBlock
      eyebrow="Reading"
      title="Books, comics, manga and PDFs"
      body="An EPUB reader that parses the spine and contents, a reader for CBZ and CBR comics and manga, and PDFs rendered by PDFium. Every one of them remembers your place."
      shotId="reading-detail"
      flip
    />
    <section class="grid items-center gap-10 border-t border-edge/60 py-16 md:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-accent">Extensibility</p>
        <h2 class="mt-3 text-3xl font-bold">The eight are just the ones it ships with</h2>
        <p class="mt-4 leading-relaxed text-muted">
          An addon can declare <em>any</em> catalog you like. Podcasts, live sports, magazines,
          lectures, concert recordings, your own archive — if you can write thirty lines of
          JavaScript that returns a list of things, it becomes a shelf in the library and behaves
          exactly like the ones built in: browsable, searchable, with artwork and drill-down.
        </p>

        <div class="mt-6 flex flex-wrap gap-2">
          {
            ['Podcasts', 'Live sports', 'Magazines', 'Lectures', 'Concerts', 'Anything else'].map(
              (c, i) => (
                <span
                  class={`rounded-full border px-3 py-1 text-sm ${
                    i === 5
                      ? 'border-accent/50 text-accent'
                      : 'border-edge bg-surface text-muted'
                  }`}
                >
                  {c}
                </span>
              ),
            )
          }
        </div>

        <p class="mt-6 text-sm leading-relaxed text-muted">
          Each addon runs in an isolated interpreter with an execution timeout, off the interface
          thread, so nothing an addon does can freeze the app. EverythingBox ships the engine, not
          the sources.
        </p>

        <a href="/addons" class="mt-6 inline-block text-sm text-accent underline">
          See how an addon is written
        </a>
      </div>
      <div>
        <Shot id="movie-detail" caption="" />
      </div>
    </section>

    <section class="border-t border-edge/60 py-16">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">Themes</p>
      <h2 class="mt-3 text-3xl font-bold">Make it look like whatever you want</h2>
      <p class="mt-4 max-w-2xl text-muted">
        Two themes ship with the app — a wall of channels and a dark cross-media bar — and more
        install from the <a class="text-accent" href={themeRegistryUrl}>theme gallery</a>. A theme is
        a JSON file you can edit: colours, layout and artwork.
      </p>
      <div class="mt-8 grid gap-8 sm:grid-cols-2">
        {
          themes.map((t) => (
            <div>
              <Shot id={t.shot} caption="" />
              <h3 class="font-semibold">{t.name}</h3>
              <p class="mt-1 text-sm text-muted">{t.blurb}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="border-t border-edge/60 py-16">
      <h2 class="text-3xl font-bold">Questions</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-2">
        {
          faqs.map((f) => (
            <div>
              <h3 class="font-semibold">{f.q}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{f.a}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="border-t border-edge/60 py-20 text-center">
      <h2 class="display text-4xl">Get it</h2>
      <p class="mx-auto mt-4 max-w-lg text-muted">
        Windows, macOS, Linux, Android TV and iOS. Free, and always will be.
      </p>
      <a
        href="/download"
        class="mt-8 inline-block rounded-lg bg-accent px-8 py-3.5 font-semibold text-base"
      >
        Download EverythingBox
      </a>
    </section>
  </div>
</Base>
